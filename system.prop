# Fstab
ro.postinstall.fstab.prefix=/system

# USB MTP
ro.sys.usb.storage.type=mtp

# Crypto (metadata encryption, stock 16.3)
ro.crypto.dm_default_key=true
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.metadata.encryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized

# Gatekeeper / Keymaster (stock 16.3 = keymaster 7.0)
ro.hardware.gatekeeper=trustonic
ro.hardware.keymaster=trustonic
ro.vendor.keymaster_version=7.0

# TEE
ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_svp_on_mtee_support=2

# Platform
ro.board.platform=mt6789
